# Shared dev defaults for the gs repo. Checked in. mise auto-loads this
# before .env.local, so .env.local can override anything here.
#
# Do NOT put secrets or per-developer values here — those go in .env.local.

# Controls the Logging mixin's active loggers (taglist string).
# See lib/logging.rb. Default is _all; narrow with e.g. "AnthropicClient->debug".
# LOGGING=_all
