# Copy to .env.local for personal dev defaults. mise auto-loads .env.local.
#
# These are inputs to operator scripts in bin/ (and the dev sign-in form,
# once added). Commented values are optional — uncomment to override.

# Default email for bin/mcp-setup and (eventually) bin/auth-create-user.
# Also prefills the sign-in form (development only).
__APP_UPPER___USER_EMAIL=you@example.com

# Display name for the dev/admin user.
__APP_UPPER___USER_NAME="Your Name"

# Password for bin/auth-create-user. Also prefills the sign-in form
# (development only).
__APP_UPPER___USER_PASSWORD=pass

# Role granted to bin/auth-create-user-provisioned dev/admin user.
__APP_UPPER___USER_ROLE=admin

# bin/mcp-setup: which host MCP clients to register.
# __APP_UPPER___MCP_CLIENTS=claude,codex

# bin/mcp-setup: base URL for the running app.
# __APP_UPPER___MCP_SETUP_URL=http://localhost:3000
